<configuration>
  <!-- Keep third-party noise (Testcontainers, Zeebe, Spring) at WARN; our own package at DEBUG so
       GovernorConnectorLoggingTest can see every level. -->
  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} %-5level %logger{30} - %msg%n</pattern>
    </encoder>
  </appender>
  <logger name="io.github.camunda.connector" level="DEBUG"/>
  <root level="WARN">
    <appender-ref ref="CONSOLE"/>
  </root>
</configuration>
