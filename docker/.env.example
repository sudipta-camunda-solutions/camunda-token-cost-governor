# Copy to docker/.env (never commit the real file) before `docker compose up`.
#
# The connector itself needs no secrets here. Everything below is connectors-bundle's own
# connection to your Camunda SaaS cluster.
#
# Create the API client in Camunda Console (your cluster -> API -> create client) with the
# "Orchestration Cluster REST API" scope (older Consoles label these Zeebe + Operate) AND the
# "Secrets" scope - the Secrets scope is what lets this self-hosted runtime read the
# GOVERNOR_PRICE_TABLE cluster secret from Console. Cluster ID and region are shown in the
# cluster's details / the client credentials block.

CAMUNDA_CLUSTER_ID=
CAMUNDA_CLUSTER_REGION=
CAMUNDA_CLIENT_ID=
CAMUNDA_CLIENT_SECRET=
