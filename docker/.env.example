# Copy to docker/.env (never commit the real file) before `docker compose up`.
#
# The connector itself needs no secrets here - its only optional configuration
# (GOVERNOR_PRICE_TABLE, the price table) is a Camunda cluster secret, set in Camunda Console/
# SaaS, not in this file. Everything below is purely connectors-bundle's own connection to your
# Camunda cluster.

# --- connectors-bundle's own connection to your Camunda cluster (SaaS shown; see ai-guardrail's
#     docker-compose.yml comments for the self-managed / hybrid alternative) ---
CAMUNDA_CLUSTER_ID=
CAMUNDA_CLUSTER_REGION=
CAMUNDA_CLIENT_ID=
CAMUNDA_CLIENT_SECRET=
